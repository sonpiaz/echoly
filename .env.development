# Development origins (`wxt dev`, `wxt build --mode development`).
# Account links + auth cookies use these via src/shared/echoly-config.ts.
# Matches `make dev-server` (8787) + `make dev-web` (4321). No secrets.
#
# `WXT_*` prefix exposes values to client code at build time (WXT docs).
#
# Override locally without touching git: put your values in `.env.development.local`
# (gitignored). Plain `.env` and `.env.local` are also gitignored.
#
# Prod builds (`wxt build` / `wxt zip`) read `.env.production` instead — see
# echoly-config.ts ECHOLY_PROD_ORIGINS. Verify: grep bundle for api.echolyhq.com.

WXT_ECHOLY_API_ORIGIN=http://localhost:8787
WXT_ECHOLY_WEB_ORIGIN=http://localhost:4321

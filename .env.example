# Echoly extension — build-time origin overrides (WXT_* prefix required).
#
# ┌─────────────────────┬──────────────────────────────────────────────────────┐
# │ Command             │ Env files loaded                                     │
# ├─────────────────────┼──────────────────────────────────────────────────────┤
# │ npm run dev         │ .env.development (+ .env.development.local)          │
# │ npm run build       │ .env.production (+ .env.production.local)            │
# │ npm run zip         │ same as build (store artifact)                       │
# └─────────────────────┴──────────────────────────────────────────────────────┘
#
# Defaults when unset: https://api.echolyhq.com + https://echolyhq.com
# (see src/shared/echoly-config.ts ECHOLY_PROD_ORIGINS).
#
# Per-machine overrides (gitignored): .env.development.local, .env.production.local

# --- Development (localhost stack) — see .env.development ---
# WXT_ECHOLY_API_ORIGIN=http://localhost:8787
# WXT_ECHOLY_WEB_ORIGIN=http://localhost:4321

# --- Production (store) — see .env.production ---
# WXT_ECHOLY_API_ORIGIN=https://api.echolyhq.com
# WXT_ECHOLY_WEB_ORIGIN=https://echolyhq.com
